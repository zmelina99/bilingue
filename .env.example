# Copy to .env.local (local) and set the same names in the host's environment.
# Server-side only: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxx
# Sender on a domain verified in Resend, e.g. bilingue.ch
CONTACT_FORM_FROM="Bilingue <kontakt@bilingue.ch>"
# Inbox receiving submissions (comma-separate for several). Change here to switch inbox.
CONTACT_FORM_TO=inbox@example.com
